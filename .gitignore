# ponytail: keep this short. One line per thing that genuinely should not
# land in someone else's clone. If you're tempted to add a glob here, ask
# yourself whether a fresh runner actually creates that file by accident.

# data/ — your Instagram exports and the personal disabledaccounts.json flag
#   list. Never push these to a remote. Recreate locally with
#   `python run.py import <src_dir> --date MM-DD-YYYY` (or via the browser
#   upload form once the server is running).
data/

# Source-mode account metadata and per-account snapshots.
profiles/
profiles.json

# dist/ — generated by `python run.py`. Recreate locally after every clone
#   (the server writes it on startup and the in-browser /import endpoint
#   updates it).
dist/

# .agents/ — local LLM tooling config (skill definitions, agent context).
#   Development-environment only; not part of the running app.
.agents/

# analyze.py — superseded by `python run.py` (run.py's own docstring: "the
#   formerly-separate analyze.py + serve.py merged into one"). Kept locally
#   as archaeology.
analyze.py


/designinspo

# Python bytecode safety net.
__pycache__/
*.pyc
*.pyo

# OS noise.
.DS_Store
Thumbs.db
desktop.ini

# Editor scratch.
.vscode/
.idea/
*.swp

# Build-pipeline artifacts for the Windows installer.
# redist/  -- WebView2 evergreen bootstrapper (~80MB), downloaded by build.py
#             on first build and cached thereafter.
# Output/  -- Inno Setup's compiled installer output (the file you ship).
# build/   -- PyInstaller temporary build output.
redist/
Output/
build/

# Runtime / accidental files.
server.log
nul

# Local double-click launcher; the actual source-mode entry point is run.py.
/localhost.bat
